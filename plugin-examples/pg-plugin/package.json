{
  "name": "pg-plugin-flow-requests",
  "version": "2.0.0",
  "description": "Postgres plugin for Flow Requests - connect via dbUrl and run parameterized SQL with postgres.js (npm:postgres)",
  "main": "dist/deno-bundle.js",
  "browser": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "webpack && deno bundle ./src/index.ts -o ./dist/deno-bundle.js",
    "prepublish": "npm run build",
    "preinstall": "npm run build || true",
    "start": "tsx src/index.ts",
    "test": "jest ./tests/*.spec.ts"
  },
  "dependencies": {
    "core-package-mini-n8n": "^1.1.5",
    "ts-loader": "^9.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.27.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": ["postgres", "database", "flow-requests", "plugin"],
  "author": "",
  "license": "ISC"
}
